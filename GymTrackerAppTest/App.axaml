<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticaGymTracker.App"
             xmlns:local="using:PracticaGymTracker"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="GhostWhite" />
            <Setter Property="Opacity" Value="0.1"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="GhostWhite" />
            <Setter Property="Opacity" Value="0.1"/>
        </Style>
        <Style Selector="Border.StatCard">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #1A000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBg}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 10 30 0 #1A000000" />
        </Style>

        <Style Selector="Border.HoverableCard">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        
        <Style Selector="Border.HoverableCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
            <Setter Property="BoxShadow" Value="0 15 40 0 #33000000" />
        </Style>

        <Style Selector="Border.GlassCard">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBg}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 4 15 0 #11000000" />
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="Foreground" Value="{DynamicResource TextWhite}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>
        <Style Selector="TextBlock.StatLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GymTrackerAppTest/Resources/Strings.ua.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBeige">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="BgDark">#121212</SolidColorBrush>
                    <SolidColorBrush x:Key="BgCard">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="TextWhite">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#888888</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMain">#FF4500</SolidColorBrush>
                    <SolidColorBrush x:Key="HoverBg">#2A2A2A</SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBeige">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="BgDark">#FFFFFF</SolidColorBrush>      
                    <SolidColorBrush x:Key="BgCard">#FDFDFD</SolidColorBrush>      
                    <SolidColorBrush x:Key="TextWhite">#121212</SolidColorBrush>   
                    <SolidColorBrush x:Key="TextMuted">#666666</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMain">#D84315</SolidColorBrush>  
                    <SolidColorBrush x:Key="HoverBg">#EAEAEA</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>